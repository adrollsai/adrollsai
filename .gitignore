.DS_Store
*.pem
*.csv

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch directory
/scratch/

# firebase service accounts
*firebase-adminsdk*.json
firebase-service-account.json

