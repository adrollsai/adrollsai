# Media and large assets
*.mp4
*.zip
public/campaign-assets/




# harness verification bundle
.tmp-verify.mjs

# harness verification bundles
.tmp-store.mjs

.tmp-live.mjs

.tmp-video.cjs

.tmp-runs.cjs

.tmp-e2e.cjs

.tmp-resume.cjs

.tmp-hard.cjs

.tmp-worker.cjs

.tmp-prod.cjs

# local run artefacts (regenerated by verify/demo scripts)
.tmp-*
.demo/
.nobogent/

# local media scratch (reel test passes)
.work/
Homeland-Regalia-Reel.mp4
Homeland-Regalia-Rahul.mp4

# PWA build artefacts (generated by @ducanh2912/next-pwa on every build).
# These must NOT be committed: sw.js embeds the _next/static chunk hashes of the
# machine that built it, so a committed copy ships stale precache entries and
# breaks offline loading. They are regenerated by 
pm run build.
# Hand-written service workers (custom-sw.js, sw-v2.js) stay tracked.
/public/sw.js
/public/workbox-*.js
/public/swe-worker-*.js
/public/fallback-*.js
# Python bytecode from helper scripts (scripts/render-spec.py etc.)
__pycache__/
*.pyc
