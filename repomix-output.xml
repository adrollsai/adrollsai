                    message: creative.primaryText,
                    link: creative.linkUrl,
                    image_hash: creativePhotoId, // Use the uploaded image hash
                    call_to_action: {
                        type: creative.ctaType || 'LEARN_MORE',
                        value: { link: creative.linkUrl }
                    }
