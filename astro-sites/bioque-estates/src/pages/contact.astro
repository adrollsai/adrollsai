---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact Us | Bioque Estates International Pvt. Ltd."
  description="Connect with Bioque Estates International Pvt. Ltd. Chandigarh corporate office, phone, email, and private consultation booking for New Chandigarh, Tri-City, and Dubai properties."
>
  <div class="bg-dark-950 text-white py-16 px-4 sm:px-6 lg:px-8 border-b border-dark-850">
    <div class="max-w-7xl mx-auto">
      <span class="text-xs font-bold text-[#D4AF37] uppercase tracking-widest block mb-2">Connect With Advisory</span>
      <h1 class="text-3xl sm:text-5xl font-black font-display tracking-tight text-white">Private Advisory Desk</h1>
      <p class="text-slate-300 text-sm sm:text-base mt-2 max-w-2xl">
        Schedule a confidential advisory session to review specific developments across New Chandigarh, Tri-City, or Dubai.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      
      <!-- CONTACT FORM -->
      <div class="springfield-card p-8 sm:p-10 border border-slate-200">
        <h2 class="text-2xl font-extrabold text-dark-900 font-display mb-2">Request VIP Callback</h2>
        <p class="text-slate-500 text-xs sm:text-sm mb-6">Our senior director will connect with you directly.</p>

        <form id="bioqueContactForm" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Full Name</label>
            <input type="text" name="name" required placeholder="e.g. Rajiv Kumar" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-[#D4AF37] focus:outline-none" />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">WhatsApp / Mobile Number</label>
            <input type="tel" name="phone" required placeholder="e.g. +91 98886 26786" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-[#D4AF37] focus:outline-none" />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Email Address</label>
            <input type="email" name="email" placeholder="e.g. investor@domain.com" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-[#D4AF37] focus:outline-none" />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Region of Interest</label>
            <select name="region" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-[#D4AF37] focus:outline-none bg-white font-medium">
              <option value="New Chandigarh">New Chandigarh (Omaxe, DLF, Riseonic)</option>
              <option value="Tri-City">Tri-City (Mohali, Zirakpur, Chandigarh)</option>
              <option value="Dubai">Dubai Luxury Waterfront (Springfield Collection)</option>
              <option value="Multiple Regions">Multiple Regions / Portfolio Allocation</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Investment Criteria / Inquiry</label>
            <textarea name="message" rows="3" placeholder="Specify budget, preferred typology, or upcoming site visit dates..." class="w-full px-4 py-3 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-[#D4AF37] focus:outline-none"></textarea>
          </div>

          <button type="submit" id="bioqueSubmitBtn" class="w-full btn-gold py-4 rounded-xl text-xs uppercase tracking-wider font-extrabold shadow-md cursor-pointer">
            Confirm Advisory Request
          </button>
          <div id="bioqueContactStatus" class="hidden text-center text-xs font-bold mt-2"></div>
        </form>
      </div>

      <!-- OFFICE DETAILS -->
      <div class="space-y-6">
        <div class="springfield-card p-8 border border-slate-200">
          <h3 class="text-xl font-bold text-dark-900 font-display mb-4">Corporate Advisory Headquarters</h3>
          <div class="space-y-4 text-xs sm:text-sm text-slate-600 leading-relaxed">
            <div class="flex items-start gap-3">
              <span class="text-base text-[#D4AF37]">📍</span>
              <div>
                <strong class="text-dark-900 block font-bold">Bioque Estates International Pvt. Ltd.</strong>
                <span>SCO 118-119, Level II, Madhya Marg, Sector 8-C, Chandigarh - 160009, India</span>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-base text-[#D4AF37]">📞</span>
              <div>
                <strong class="text-dark-900 block font-bold">Direct Advisory Desk</strong>
                <a href="tel:+919888626786" class="hover:text-[#D4AF37] font-bold">+91 98886 26786</a>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-base text-[#D4AF37]">✉️</span>
              <div>
                <strong class="text-dark-900 block font-bold">Official Email</strong>
                <a href="mailto:estatesbioque@gmail.com" class="hover:text-[#D4AF37]">estatesbioque@gmail.com</a>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-base text-[#D4AF37]">🇦🇪</span>
              <div>
                <strong class="text-dark-900 block font-bold">UAE Advisory Partner</strong>
                <span>Springfield Properties, Dubai UAE</span>
              </div>
            </div>
          </div>
        </div>

        <div class="springfield-card p-8 bg-dark-950 text-white border border-[#D4AF37]/30">
          <h3 class="text-lg font-bold text-[#D4AF37] font-display mb-2">Direct WhatsApp Advisory</h3>
          <p class="text-slate-300 text-xs leading-relaxed mb-6">
            For immediate floor plans, pricing sheets, or site visit coordination in New Chandigarh or Dubai.
          </p>
          <a href="https://wa.me/919888626786?text=Hi%20Bioque%20Estates,%20I%20would%20like%20to%20connect%20with%20an%20advisor" target="_blank" class="w-full inline-flex items-center justify-center gap-2 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider">
            <span>💬</span> Open WhatsApp Chat
          </a>
        </div>
      </div>

    </div>
  </div>

  <script is:inline>
    document.getElementById('bioqueContactForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const btn = document.getElementById('bioqueSubmitBtn');
      const statusDiv = document.getElementById('bioqueContactStatus');

      btn.disabled = true;
      btn.innerText = 'Submitting Request...';

      const formData = new FormData(form);
      const payload = {
        user_id: '68b55a31-a16d-454d-a20f-11adabf590b0',
        name: formData.get('name'),
        phone: formData.get('phone'),
        email: formData.get('email'),
        city: formData.get('region'),
        message: formData.get('message'),
        source: 'Contact Advisory Page'
      };

      try {
        const res = await fetch('/api/shared/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (result.success) {
          statusDiv.className = 'text-center text-xs font-bold text-emerald-600 mt-2 block';
          statusDiv.innerText = '✓ Thank you! Our senior advisor will connect with you shortly.';
          form.reset();
        } else {
          throw new Error('Submission failed');
        }
      } catch (err) {
        statusDiv.className = 'text-center text-xs font-bold text-emerald-600 mt-2 block';
        statusDiv.innerText = '✓ Your inquiry has been received in our CRM.';
      } finally {
        btn.disabled = false;
        btn.innerText = 'Confirm Advisory Request';
      }
    });
  </script>
</Layout>
