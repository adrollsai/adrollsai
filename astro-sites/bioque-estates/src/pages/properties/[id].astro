---
import Layout from '../../layouts/Layout.astro';
import { getBioqueProperties, getBioquePropertyById } from '../../lib/supabase';

export async function getStaticPaths() {
  const properties = await getBioqueProperties();
  return properties.map((p) => ({
    params: { id: p.id },
    props: { property: p }
  }));
}

const { id } = Astro.params;
let property = Astro.props.property;

if (!property && id) {
  property = await getBioquePropertyById(id) || undefined;
}

if (!property) {
  return Astro.redirect('/properties');
}

const images = property.images && property.images.length > 0 
  ? property.images 
  : [property.image_url || 'https://www.omaxe.com/projects/banner_1770812950769.jpeg'];

const PHONE_RAW = '919888626786';
const waLink = `https://wa.me/${PHONE_RAW}?text=${encodeURIComponent(`Hi Bioque Estates, I am interested in ${property.title} located at ${property.address}. Please provide investment brochure and floor plan.`)}`;

const config = property.configurations || {};
const units = config.units || [];
const amenities = config.amenities || [];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "SingleFamilyResidence",
  "name": property.title,
  "description": property.description,
  "image": images,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": property.address,
    "addressLocality": property.region === 'Dubai' ? 'Dubai' : (property.region === 'Tri-City' ? 'Mohali' : 'New Chandigarh'),
    "addressCountry": property.region === 'Dubai' ? 'AE' : 'IN'
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": property.price?.includes('AED') ? 'AED' : 'INR',
    "price": property.price,
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "RealEstateAgent",
      "name": "Bioque Estates International Pvt. Ltd.",
      "telephone": "+91 98886 26786"
    }
  }
};
---

<Layout 
  title={`${property.title} | Bioque Estates International Pvt. Ltd.`}
  description={property.description?.slice(0, 160) || `Explore ${property.title} in ${property.address}. Luxury residence curated by Bioque Estates International Pvt. Ltd.`}
  image={images[0]}
  schema={productSchema}
>
  <!-- BREADCRUMBS -->
  <div class="bg-white border-b border-slate-200 py-3 px-4 sm:px-8 text-xs text-slate-500">
    <div class="max-w-7xl mx-auto flex items-center space-x-2">
      <a href="/" class="hover:text-[#D4AF37] transition-colors">Home</a>
      <span>/</span>
      <a href="/properties" class="hover:text-[#D4AF37] transition-colors">Portfolio</a>
      <span>/</span>
      <span class="text-[#D4AF37] font-bold">{property.region}</span>
      <span>/</span>
      <span class="text-dark-900 font-bold truncate">{property.title}</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- HEADER -->
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end gap-6 pb-8 border-b border-slate-200">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="px-3.5 py-1 rounded-full bg-dark-900 text-[#D4AF37] text-xs font-bold uppercase tracking-wider border border-[#D4AF37]/30">
            {property.region === 'Dubai' ? '🇦🇪 Dubai Waterfront & Sky' : (property.region === 'Tri-City' ? '🏙️ Tri-City Flagship' : '🌳 New Chandigarh Luxury')}
          </span>
          <span class="px-3.5 py-1 rounded-full bg-amber-50 text-[#AA8222] border border-[#D4AF37]/40 text-xs font-bold uppercase tracking-wider">
            {property.property_type || 'Luxury Residence'}
          </span>
          <span class="px-3.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold uppercase tracking-wider">
            {config.status || 'Active Portfolio'}
          </span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-dark-900 font-display tracking-tight">
          {property.title}
        </h1>
        <p class="text-sm sm:text-base text-slate-500 mt-2 flex items-center gap-1.5 font-medium">
          <span class="text-[#D4AF37]">📍</span> {property.address}
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="bg-amber-50/50 border border-[#D4AF37]/30 px-6 py-3.5 rounded-2xl">
          <span class="text-[10px] uppercase font-bold text-slate-500 block tracking-wider">Pricing / Investment</span>
          <span class="text-2xl sm:text-3xl font-black text-dark-900 font-display">
            {property.price || 'Price on Application'}
          </span>
        </div>
        <a href={waLink} target="_blank" class="flex items-center gap-2 px-6 py-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md transition-all">
          <span>💬</span> WhatsApp Advisory
        </a>
      </div>
    </div>

    <!-- MAIN GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 mt-10">
      
      <!-- LEFT 2 COLS: GALLERY, OVERVIEW, UNITS, AMENITIES -->
      <div class="lg:col-span-2 space-y-10">
        
        <!-- MAIN GALLERY -->
        <div class="space-y-4">
          <div class="relative h-[380px] sm:h-[480px] rounded-3xl overflow-hidden bg-dark-950 shadow-xl border border-slate-200">
            <img 
              id="bioqueMainImage" 
              src={images[0]} 
              alt={property.title} 
              class="w-full h-full object-cover transition-opacity duration-300" 
            />
            <div class="absolute bottom-4 left-4 bg-dark-950/80 backdrop-blur-md px-4 py-2 rounded-xl text-[#D4AF37] text-xs font-bold border border-[#D4AF37]/30">
              Verified Architectural Asset
            </div>
          </div>

          <!-- THUMBNAILS -->
          {images.length > 1 && (
            <div class="flex gap-3 overflow-x-auto pb-2">
              {images.map((img: string, idx: number) => (
                <button 
                  onclick={`document.getElementById('bioqueMainImage').src = '${img}';`}
                  class="w-24 h-20 rounded-xl overflow-hidden border-2 border-transparent hover:border-[#D4AF37] focus:border-[#D4AF37] transition-all shrink-0 bg-slate-100 cursor-pointer"
                >
                  <img src={img} alt={`Preview ${idx + 1}`} class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- OVERVIEW & HIGHLIGHTS -->
        <div class="springfield-card p-8 sm:p-10 border border-slate-200/80">
          <h2 class="text-2xl font-extrabold text-dark-900 font-display mb-6">
            Residence Overview & Architectural Highlights
          </h2>
          <div class="prose max-w-none text-slate-700 leading-relaxed text-sm sm:text-base space-y-4">
            <p>{property.description}</p>
          </div>

          <!-- SPECS -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 pt-8 border-t border-slate-100">
            <div class="bg-slate-50 p-4 rounded-xl">
              <span class="text-[10px] uppercase font-bold text-slate-400 block">Region</span>
              <span class="font-bold text-[#AA8222] text-sm">{property.region}</span>
            </div>
            <div class="bg-slate-50 p-4 rounded-xl">
              <span class="text-[10px] uppercase font-bold text-slate-400 block">Sizes</span>
              <span class="font-bold text-dark-900 text-sm">{config.sizes || 'Custom Layouts'}</span>
            </div>
            <div class="bg-slate-50 p-4 rounded-xl">
              <span class="text-[10px] uppercase font-bold text-slate-400 block">Possession</span>
              <span class="font-bold text-dark-900 text-sm">{config.possession || 'Ready / Handover'}</span>
            </div>
            <div class="bg-slate-50 p-4 rounded-xl">
              <span class="text-[10px] uppercase font-bold text-slate-400 block">Advisory Desk</span>
              <span class="font-bold text-emerald-700 text-sm">✓ Authorized</span>
            </div>
          </div>
        </div>

        <!-- CONFIGURATIONS / AVAILABLE UNITS -->
        {units.length > 0 && (
          <div class="springfield-card p-8 sm:p-10 border border-slate-200/80">
            <h3 class="text-xl font-bold text-dark-900 font-display mb-6">
              Available Typologies & Floor Plan Configurations
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {units.map((unit: string) => (
                <div class="flex items-center gap-3 p-3.5 bg-slate-50 rounded-xl border border-slate-100 text-xs font-bold text-slate-800">
                  <span class="text-[#D4AF37] text-base">✦</span>
                  <span>{unit}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- AMENITIES -->
        {amenities.length > 0 && (
          <div class="springfield-card p-8 sm:p-10 border border-slate-200/80">
            <h3 class="text-xl font-bold text-dark-900 font-display mb-6">
              Signature Enclave Amenities & Lifestyle
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {amenities.map((amenity: string) => (
                <div class="flex items-center gap-3 p-3.5 bg-slate-50 rounded-xl border border-slate-100 text-xs font-semibold text-slate-700">
                  <span class="text-emerald-600 font-bold">✓</span>
                  <span>{amenity}</span>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- RIGHT COL: BOOKING & SITE VISIT FORM -->
      <div class="space-y-6">
        
        <div class="springfield-card p-8 border-2 border-[#D4AF37]/20 sticky top-28 bg-white shadow-xl">
          <div class="mb-6">
            <span class="text-[10px] font-black text-[#D4AF37] uppercase tracking-widest block mb-1">VIP Advisory</span>
            <h3 class="text-2xl font-extrabold text-dark-900 font-display">Schedule Private Tour</h3>
            <p class="text-slate-500 text-xs mt-1 leading-relaxed">
              Book a personal site inspection or video consultation with our senior advisory desk for <strong class="text-dark-900">{property.title}</strong>.
            </p>
          </div>

          <form id="bioqueProductForm" class="space-y-4">
            <input type="hidden" name="property_id" value={property.id} />
            <input type="hidden" name="property_title" value={property.title} />
            <input type="hidden" name="region" value={property.region} />

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Your Full Name</label>
              <input type="text" name="name" required placeholder="e.g. Rajiv Aggarwal" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-[#D4AF37] focus:outline-none" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Phone Number (WhatsApp)</label>
              <input type="tel" name="phone" required placeholder="e.g. +91 98886 26786" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-[#D4AF37] focus:outline-none" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Email Address</label>
              <input type="email" name="email" placeholder="e.g. client@bioqueestates.com" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-[#D4AF37] focus:outline-none" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Preferred Date & Time</label>
              <input type="datetime-local" name="preferred_time" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-[#D4AF37] focus:outline-none" />
            </div>

            <button type="submit" id="bioqueSubmitBtn" class="w-full btn-gold py-4 rounded-xl text-xs uppercase tracking-wider font-extrabold shadow-md cursor-pointer">
              Confirm Private Site Visit
            </button>
            <div id="bioqueFormStatus" class="hidden text-center text-xs font-bold mt-2"></div>
          </form>

          <div class="mt-6 pt-6 border-t border-slate-100 text-center">
            <p class="text-xs text-slate-500 mb-3">Speak with our director directly:</p>
            <a href={waLink} target="_blank" class="w-full inline-flex items-center justify-center gap-2 py-3 rounded-xl bg-emerald-50 text-emerald-700 hover:bg-emerald-100 transition-colors text-xs font-bold border border-emerald-200">
              <span>💬</span> Direct WhatsApp to Advisory
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>

  <script is:inline>
    document.getElementById('bioqueProductForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const btn = document.getElementById('bioqueSubmitBtn');
      const statusDiv = document.getElementById('bioqueFormStatus');

      btn.disabled = true;
      btn.innerText = 'Submitting Request...';

      const formData = new FormData(form);
      const payload = {
        user_id: '68b55a31-a16d-454d-a20f-11adabf590b0',
        name: formData.get('name'),
        phone: formData.get('phone'),
        email: formData.get('email'),
        city: formData.get('region') || 'New Chandigarh',
        custom_question_0: formData.get('property_title'),
        custom_question_1: formData.get('preferred_time'),
        custom_fields: {
          property_id: formData.get('property_id'),
          property_name: formData.get('property_title'),
          source: 'Product Detail Page'
        }
      };

      try {
        const res = await fetch('/api/shared/landing-page/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        statusDiv.className = 'text-center text-xs font-bold text-emerald-600 mt-2 block';
        statusDiv.innerText = '✓ Site visit confirmed! Our senior advisor will call you shortly.';
        form.reset();
      } catch (err) {
        statusDiv.className = 'text-center text-xs font-bold text-emerald-600 mt-2 block';
        statusDiv.innerText = '✓ Request noted. Our advisor will connect via WhatsApp/Phone.';
      } finally {
        btn.disabled = false;
        btn.innerText = 'Confirm Private Site Visit';
      }
    });
  </script>
</Layout>
