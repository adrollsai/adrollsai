---
import Layout from '../../layouts/Layout.astro';
import { getDeccanProperties } from '../../lib/supabase';

const properties = await getDeccanProperties();

const catalogSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Deccan Realtors Property Inventory & Listings",
  "description": "Explore verified residential and commercial plots curated by Deccan Realtors across Wardha Road, Outer Ring Road, and prime corridors in Nagpur.",
  "hasPart": properties.map((p, idx) => ({
    "@type": "SingleFamilyResidence",
    "name": p.title,
    "position": idx + 1,
    "url": `https://deccanrealtors.com/properties/${p.id}`,
    "image": p.image_url,
    "address": p.address
  }))
};
---

<Layout 
  title="Real Estate Inventory & Verified Plots | Deccan Realtors"
  description="Explore verified residential plots, township developments, and commercial properties curated by Deccan Realtors in Nagpur. Complete legal due diligence."
  schema={catalogSchema}
>
  <!-- HEADER -->
  <div class="bg-brand-950 text-white py-16 px-4 sm:px-6 lg:px-8 border-b border-brand-800">
    <div class="max-w-7xl mx-auto">
      <span class="text-xs font-bold text-accent-400 uppercase tracking-widest block mb-2">Curated Inventory</span>
      <h1 class="text-3xl sm:text-5xl font-black font-display tracking-tight">Verified Property Portfolio</h1>
      <p class="text-slate-300 text-sm sm:text-base mt-2 max-w-2xl">
        Every opportunity featured below has passed 100% legal title verification, RERA compliance audit, and micro-market growth evaluation.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- SEARCH & CATEGORY FILTER BAR -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-10">
      <div class="flex flex-wrap gap-2 w-full md:w-auto">
        <button class="catalog-filter-btn px-5 py-2.5 rounded-xl bg-brand-900 text-white text-xs font-bold cursor-pointer transition-all" data-type="All">
          All Properties ({properties.length})
        </button>
        <button class="catalog-filter-btn px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold cursor-pointer transition-all" data-type="Residential Plots">
          Residential Plots
        </button>
        <button class="catalog-filter-btn px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold cursor-pointer transition-all" data-type="Commercial">
          Commercial
        </button>
      </div>

      <div class="w-full md:w-72">
        <input 
          type="text" 
          id="catalogSearch" 
          placeholder="Search projects or locations..." 
          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-brand-900 focus:outline-none"
        />
      </div>
    </div>

    <!-- PROPERTIES GRID -->
    <div id="catalogGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {properties.map((p) => {
        const img = p.image_url || (p.images && p.images[0]) || 'https://hpssqssdewmkmafxlfud.supabase.co/storage/v1/object/public/public-assets/logos/93c65dee-87a5-48e3-a2d2-406182a33b37/deccan_realtors_93c65dee-87a5-48e3-a2d2-406182a33b37_1787575176651.png';
        const waLink = `https://wa.me/918600080096?text=${encodeURIComponent(`Hi Deccan Realtors, I am interested in ${p.title}`)}`;
        return (
          <div class="property-card springfield-card overflow-hidden flex flex-col group cursor-pointer" data-title={p.title.toLowerCase()} data-type={p.property_type || ''} data-address={p.address?.toLowerCase() || ''}>
            <a href={`/properties/${p.id}`} class="block relative h-64 overflow-hidden bg-slate-100">
              <img src={img} alt={p.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              <div class="absolute top-3 left-3">
                <span class="px-3 py-1 rounded-full bg-brand-900/90 backdrop-blur-md text-white text-[10px] font-bold uppercase tracking-wider">
                  {p.property_type || 'Curated Asset'}
                </span>
              </div>
              <div class="absolute bottom-3 left-3 right-3">
                <span class="text-base font-black text-brand-900 bg-white/95 backdrop-blur-md px-3.5 py-1 rounded-xl shadow-sm font-display">
                  {p.price || 'Price on Request'}
                </span>
              </div>
            </a>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <a href={`/properties/${p.id}`}>
                  <h3 class="text-lg font-bold text-brand-900 mb-1.5 line-clamp-1 group-hover:text-accent-600 transition-colors font-display">
                    {p.title}
                  </h3>
                </a>
                <p class="text-xs text-slate-500 font-medium mb-3 flex items-center gap-1">
                  <span>📍</span> <span class="truncate">{p.address || 'Nagpur Corridor'}</span>
                </p>
                <p class="text-slate-600 text-xs line-clamp-2 leading-relaxed mb-4">
                  {p.description || 'Verified property opportunity curated by Deccan Realtors.'}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
                <a href={`/properties/${p.id}`} class="flex-1 text-center py-2.5 rounded-xl bg-brand-900 text-white hover:bg-brand-800 font-bold text-xs uppercase tracking-wider transition-all">
                  View Full Product Page →
                </a>
                <a href={waLink} target="_blank" class="p-2.5 rounded-xl bg-emerald-50 text-emerald-600 hover:bg-emerald-600 hover:text-white transition-all shrink-0" title="Chat on WhatsApp">
                  💬
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>

  </div>

  <script is:inline>
    const searchInput = document.getElementById('catalogSearch');
    const filterBtns = document.querySelectorAll('.catalog-filter-btn');
    const cards = document.querySelectorAll('.property-card');
    let currentType = 'All';

    function filterCards() {
      const q = (searchInput?.value || '').toLowerCase().trim();
      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const type = card.getAttribute('data-type') || '';
        const address = card.getAttribute('data-address') || '';

        const matchType = currentType === 'All' || type.toLowerCase().includes(currentType.toLowerCase());
        const matchSearch = !q || title.includes(q) || address.includes(q) || type.toLowerCase().includes(q);

        if (matchType && matchSearch) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    searchInput?.addEventListener('input', filterCards);

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentType = btn.getAttribute('data-type') || 'All';
        filterBtns.forEach(b => {
          b.classList.remove('bg-brand-900', 'text-white');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.remove('bg-slate-100', 'text-slate-700');
        btn.classList.add('bg-brand-900', 'text-white');
        filterCards();
      });
    });
  </script>
</Layout>
