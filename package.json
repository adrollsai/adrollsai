{
  "name": "nobogent-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "update-types": "npx supabase gen types typescript --project-id hpssqssdewmkmafxlfud > supabase/database.types.ts",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npx cap run android",
    "cap:run:ios": "npx cap run ios",
    "verify:harness": "esbuild scripts/verify-harness-projection.ts --bundle --platform=node --format=esm --outfile=.tmp-verify.mjs --log-level=warning --external:@supabase/supabase-js && node .tmp-verify.mjs",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "verify:harness:store": "esbuild scripts/verify-harness-store.ts --bundle --platform=node --format=esm --outfile=.tmp-store.mjs --log-level=warning && node .tmp-store.mjs",
    "verify:harness:all": "npm run verify:harness && npm run verify:harness:store",
    "verify:harness:live": "esbuild scripts/verify-harness-live.ts --bundle --platform=node --format=esm --outfile=.tmp-live.mjs --log-level=warning --external:@supabase/supabase-js && node .tmp-live.mjs",
    "verify:video": "esbuild scripts/verify-video.ts --bundle --platform=node --format=cjs --outfile=.tmp-video.cjs --log-level=warning && node .tmp-video.cjs",
    "verify:vision": "node scripts/verify-vision.mjs",
    "verify:media": "esbuild scripts/verify-media-studio.ts --bundle --platform=node --format=cjs --outfile=.tmp-media.cjs --log-level=warning --external:@supabase/supabase-js --external:@aws-sdk/client-s3 && node .tmp-media.cjs",
    "verify:toolset": "esbuild scripts/verify-toolset.ts --bundle --platform=node --format=cjs --outfile=.tmp-toolset.cjs --log-level=warning --external:@supabase/supabase-js --external:@e2b/code-interpreter --external:@aws-sdk/client-s3 && node .tmp-toolset.cjs",
    "verify:mcp": "esbuild scripts/verify-mcp.ts --bundle --platform=node --format=cjs --outfile=.tmp-mcp.cjs --log-level=warning --external:@supabase/supabase-js --external:@e2b/code-interpreter --external:@aws-sdk/client-s3 && node .tmp-mcp.cjs",
    "verify:sites": "esbuild scripts/verify-sites.ts --bundle --platform=node --format=cjs --outfile=.tmp-sites.cjs --log-level=warning --external:@supabase/supabase-js --external:@e2b/code-interpreter --external:@aws-sdk/client-s3 && node .tmp-sites.cjs",
    "audit:flows": "esbuild scripts/audit-flows.ts --bundle --platform=node --format=cjs --outfile=.tmp-audit.cjs --log-level=warning --external:@supabase/supabase-js && node .tmp-audit.cjs",
    "verify:flows": "esbuild scripts/verify-flows.ts --bundle --platform=node --format=cjs --outfile=.tmp-flows.cjs --log-level=warning --external:@supabase/supabase-js && node .tmp-flows.cjs",
    "verify:analytics": "esbuild scripts/verify-analytics.ts --bundle --platform=node --format=cjs --outfile=.tmp-analytics.cjs --log-level=warning --external:@supabase/supabase-js && node .tmp-analytics.cjs",
    "verify:reporting": "esbuild scripts/verify-reporting.ts --bundle --platform=node --format=cjs --outfile=.tmp-rep.cjs --log-level=warning --external:@supabase/supabase-js && node .tmp-rep.cjs",
    "verify:billing": "esbuild scripts/verify-billing.ts --bundle --platform=node --format=cjs --outfile=.tmp-bill.cjs --log-level=warning && node .tmp-bill.cjs",
    "verify:continue": "esbuild scripts/verify-continue.ts --bundle --platform=node --format=cjs --outfile=.tmp-cont.cjs --log-level=warning && node .tmp-cont.cjs",
    "test:recipe": "esbuild scripts/test-recipe.ts --bundle --platform=node --format=cjs --outfile=.tmp-recipe.cjs --log-level=warning --external:@e2b/code-interpreter --external:@aws-sdk/client-s3 --alias:@/utils/r2=./utils/r2 && node .tmp-recipe.cjs",
    "demo:behind": "esbuild scripts/demo-behind-subject.ts --bundle --platform=node --format=cjs --outfile=.tmp-behind.cjs --log-level=warning --external:@e2b/code-interpreter --external:@aws-sdk/client-s3 --alias:@/utils/r2=./utils/r2 && node .tmp-behind.cjs",
    "measure:render": "esbuild scripts/measure-render-cost.ts --bundle --platform=node --format=cjs --outfile=.tmp-measure.cjs --log-level=warning --alias:@/utils/r2=./utils/r2 --external:@e2b/code-interpreter --external:@aws-sdk/client-s3 && node .tmp-measure.cjs",
    "check:render-script": "esbuild scripts/print-render-script.ts --bundle --platform=node --format=cjs --outfile=.tmp-print-render.cjs --log-level=warning && node .tmp-print-render.cjs",
    "verify:runs": "esbuild scripts/verify-runs.ts --bundle --platform=node --format=cjs --outfile=.tmp-runs.cjs --log-level=warning --external:@supabase/supabase-js && node .tmp-runs.cjs",
    "verify:run-e2e": "esbuild scripts/verify-run-e2e.ts --bundle --platform=node --format=cjs --outfile=.tmp-e2e.cjs --log-level=warning --external:@supabase/supabase-js && node .tmp-e2e.cjs",
    "verify:run-resume": "esbuild scripts/verify-run-resume.ts --bundle --platform=node --format=cjs --outfile=.tmp-resume.cjs --log-level=warning --external:@supabase/supabase-js && node .tmp-resume.cjs",
    "verify:all": "npm run verify:harness && npm run verify:harness:store && npm run verify:runs",
    "verify:live": "npm run verify:hardening && npm run verify:production && npm run verify:run-e2e && npm run verify:run-resume",
    "verify:hardening": "esbuild scripts/verify-hardening.ts --bundle --platform=node --format=cjs --outfile=.tmp-hard.cjs --log-level=warning --external:@supabase/supabase-js && node .tmp-hard.cjs",
    "worker": "esbuild scripts/worker.ts --bundle --platform=node --format=cjs --outfile=.tmp-worker.cjs --log-level=warning --external:@supabase/supabase-js && node .tmp-worker.cjs",
    "verify:production": "esbuild scripts/verify-production-tier.ts --bundle --platform=node --format=cjs --outfile=.tmp-prod.cjs --log-level=warning --external:@supabase/supabase-js && node .tmp-prod.cjs",
    "typecheck:src": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.81",
