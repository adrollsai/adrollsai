<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launch icon: the brand gradient as background, the orbital mark as
     foreground. The foreground PNGs already keep the mark inside the 66% safe
     zone, so launcher masks (circle, squircle, teardrop) cannot clip it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
