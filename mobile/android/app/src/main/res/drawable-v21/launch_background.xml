<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch screen shown while the Flutter engine warms up.

  White plate with the real Nobogent lockup centred - the same thing the web app
  shows when it boots. An earlier revision used a violet gradient with a
  hand-drawn approximation of the mark, which was wrong.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
