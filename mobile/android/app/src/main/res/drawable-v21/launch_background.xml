<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch screen shown while the Flutter engine warms up.
  Brand gradient background with the orbital mark centred, so the first thing a
  user sees is already Nobogent rather than a white flash.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#6220D8"
                android:endColor="#3F3FE0"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
